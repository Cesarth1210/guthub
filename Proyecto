local function getStrengthRequiredForRebirth()
    return math.floor(5000 + (2500 * rebirthsStat.Value))
end

local function updateRebirthUI()
    local current = rebirthsStat.Value
    totalRebirthsGained = current - initialRebirths
    rebirthsInfoLabel.Text = "Renacimientos: " .. FormatNumber(current) .. " | Ganados: " .. FormatNumber(totalRebirthsGained)
end

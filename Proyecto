-- FUNCIONES AUXILIARES
-- ==========================================
local function FormatNumber(value)
    local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi"}
    local idx = 1
    while value >= 1000 and idx < #suffixes do
        value = value / 1000
        idx = idx + 1
    end
    return string.format("%.2f%s", value, suffixes[idx])
end

local function FormatNumberWithCommas(value)
    local formatted = tostring(value):reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return formatted:gsub("^,", "")
end

local function FormatDisplay(value)
    return "[ " .. FormatNumberWithCommas(value) .. " | " .. FormatNumber(value) .. " ]"
end


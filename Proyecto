task.spawn(function()
    while true do
        local now = tick()
        local elapsed = now - startTime

        local days = math.floor(elapsed / 86400)
        local hours = math.floor((elapsed % 86400) / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = math.floor(elapsed % 60)
        uptimeLabel.Text = string.format("%dd %dh %dm %ds", days, hours, minutes, seconds)
        
        requiredStrengthLabel.Text = "Fuerza Necesaria: " .. formatNumberFast(getStrengthRequiredForRebirth())

        table.insert(rebirthHistory, {time = now, value = rebirthsStat.Value})
        
        while #rebirthHistory > 0 and now - rebirthHistory[1].time > 3600 do
            table.remove(rebirthHistory, 1)
        end

        if #rebirthHistory >= 2 then
            local rDelta = rebirthHistory[#rebirthHistory].value - rebirthHistory[1].value
            local tDelta = rebirthHistory[#rebirthHistory].time - rebirthHistory[1].time
            if tDelta > 0 then
                local perSec = rDelta / tDelta
                paceLabel.Text = string.format("Ritmo: %s/Hora | %s/Día | %s/Sem.", 
                    formatNumberFast(perSec * 3600), formatNumberFast(perSec * 86400), formatNumberFast(perSec * 604800))
            end
        end

        if elapsed > 0 then
            local avgPerSec = totalRebirthsGained / elapsed
            avgPaceLabel.Text = string.format("Promedio: %s/Hora | %s/Día | %s/Sem.", 
                formatNumberFast(avgPerSec * 3600), formatNumberFast(avgPerSec * 86400), formatNumberFast(avgPerSec * 604800))
        end

        task.wait(1) 
    end
end)


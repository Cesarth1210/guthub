-- ✅ FIX: Anti Fling ahora reconecta al respawn
local antiFlingEnabled = false
local antiFlingConn
local function applyAntiFling()
    if not antiFlingEnabled then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and not root:FindFirstChild("AntiFlingBV") then
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "AntiFlingBV"
        bv.MaxForce = Vector3.new(1e5, 0, 1e5)
        bv.Velocity = Vector3.zero
        bv.P = 1250
    end
end

MainTab:AddSwitch("Anti Fling", function(bool)
    antiFlingEnabled = bool
    if bool then
        applyAntiFling()
        if antiFlingConn then antiFlingConn:Disconnect() end
        antiFlingConn = player.CharacterAdded:Connect(function()
            task.wait(1)
            applyAntiFling()
        end)
    else
        if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root and root:FindFirstChild("AntiFlingBV") then
                root.AntiFlingBV:Destroy()
            end
        end
    end
end)

-- ✅ FIX: Lock Position más estable
local lockConnection
MainTab:AddSwitch("Lock Position", function(Value)
    if Value then
        lockConnection = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end

            if not hum:FindFirstChild("LockState") then
                hum.WalkSpeed = 0; hum.JumpPower = 0; hum.AutoRotate = false
                hum:ChangeState(Enum.HumanoidStateType.Physics)
                local bv = Instance.new("BoolValue", hum)
                bv.Name = "LockState"

local function countEquipped(playerObj, petName)
    local eq = playerObj:FindFirstChild("equippedPets")
    if not eq then return 0 end
    local count = 0
    for _, slot in pairs(eq:GetChildren()) do
        if slot:FindFirstChild("petReference") and slot.petReference.Value then
            if slot.petReference.Value.Name == petName then count = count + 1 end
        end
    end
    return count
end

local function calculateLocalPlayerDamage()
    local str = LocalPlayer.leaderstats and LocalPlayer.leaderstats:FindFirstChild("Strength")
    if not str then return 0 end
    local base = str.Value * 0.1
    local wc = countEquipped(LocalPlayer, "Wild Wizard")
    local wb = wc * 0.33
    wildWizardLabel.Text = "Wild Wizard equipped: " .. wc .. " (" .. FormatDisplay(base * wb) .. " bonus)"
    return base * (1 + wb)
end

local function calculateEnemyHealth(tp)
    if not tp then return 0 end
    local d = tp:FindFirstChild("Durability") and tp.Durability.Value or 0
    local uf = tp:FindFirstChild("ultimatesFolder")
    local mult = 1
    if uf and uf:FindFirstChild("Infernal Health") then
        mult = mult + 0.15 * uf["Infernal Health"].Value
    end
    return d * mult
end

local function calculateHitsToKill(hp, dmg)
    if dmg <= 0 then return "∞" end
    local hits = math.ceil(hp / dmg)
    return hits > 50 and "∞" or (hits < 1 and 1 or hits)
end


local features = window:AddTab("Calc. Estadísticas")
local playerLocal = LocalPlayer
local leaderstatsLocal = playerLocal:WaitForChild("leaderstats")
local strengthStatLocal = leaderstatsLocal:WaitForChild("Strength")
local durabilityStatLocal = playerLocal:WaitForChild("Durability")

local stopwatchLabel = features:AddLabel("Fast Rep Time: 0d 0h 0m 0s")
local projectedStrengthLabel = features:AddLabel("Strength Rate: 0/H | 0/D | 0/Sem | 0/Mes")
local projectedDurabilityLabel = features:AddLabel("Durability Rate: 0/H | 0/D | 0/Sem | 0/Mes")
features:AddLabel("")
local statsLabel = features:AddLabel("Stats:")
local strengthLabel = features:AddLabel("Strength: 0 | Gained: 0")
local durabilityLabel = features:AddLabel("Durability: 0 | Gained: 0")

local startTimeCalc = tick()
local initialStrengthCalc = strengthStatLocal.Value
local initialDurabilityCalc = durabilityStatLocal.Value
local trackingStartedCalc = false
local strengthHistoryCalc = {}
local durabilityHistoryCalc = {}
local calculationIntervalCalc = 10

task.spawn(function()
    local lastCalcTime = tick()
    while true do
        local currentTime = tick()
        local cs = strengthStatLocal.Value
        local cd = durabilityStatLocal.Value

        if not trackingStartedCalc and (cs - initialStrengthCalc) >= 100e9 then
            trackingStartedCalc = true
            startTimeCalc = tick()
            strengthHistoryCalc = {}
            durabilityHistoryCalc = {}
        end

        if trackingStartedCalc then
            local elapsedTime = currentTime - startTimeCalc
            local days = math.floor(elapsedTime / 86400)
            local hours = math.floor((elapsedTime % 86400) / 3600)
            local minutes = math.floor((elapsedTime % 3600) / 60)
            local seconds = math.floor(elapsedTime % 60)
            stopwatchLabel.Text = string.format("Fast Rep Time: %dd %dh %dm %ds", days, hours, minutes, seconds)

            strengthLabel.Text = "Strength: " .. FormatNumber(cs) .. " | Gained: " .. FormatNumber(cs - initialStrengthCalc)
            durabilityLabel.Text = "Durability: " .. FormatNumber(cd) .. " | Gained: " .. FormatNumber(cd - initialDurabilityCalc)

            table.insert(strengthHistoryCalc, {time = currentTime, value = cs})
            table.insert(durabilityHistoryCalc, {time = currentTime, value = cd})
            while #strengthHistoryCalc > 0 and currentTime - strengthHistoryCalc[1].time > calculationIntervalCalc do
                table.remove(strengthHistoryCalc, 1)
            end
            while #durabilityHistoryCalc > 0 and currentTime - durabilityHistoryCalc[1].time > calculationIntervalCalc do
                table.remove(durabilityHistoryCalc, 1)
            end

            if currentTime - lastCalcTime >= calculationIntervalCalc then
                lastCalcTime = currentTime
                if #strengthHistoryCalc >= 2 then
                    local d = strengthHistoryCalc[#strengthHistoryCalc].value - strengthHistoryCalc[1].value
                    local perSec = d / calculationIntervalCalc
                    projectedStrengthLabel.Text = "Strength Rate: " .. FormatNumber(perSec * 3600) .. "/H | " .. FormatNumber(perSec * 86400) .. "/D | " .. FormatNumber(perSec * 604800) .. "/Sem | " .. FormatNumber(perSec * 2592000) .. "/Mes"
                end
                if #durabilityHistoryCalc >= 2 then
                    local d = durabilityHistoryCalc[#durabilityHistoryCalc].value - durabilityHistoryCalc[1].value
                    local perSec = d / calculationIntervalCalc
                    projectedDurabilityLabel.Text = "Durability Rate: " .. FormatNumber(perSec * 3600) .. "/H | " .. FormatNumber(perSec * 86400) .. "/D | " .. FormatNumber(perSec * 604800) .. "/Sem | " .. FormatNumber(perSec * 2592000) .. "/Mes"
                end
            end
        end
        task.wait(0.05)
    end
end)


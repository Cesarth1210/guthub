local function FormatAbbreviatedStat(number)
    local abbr = {"", "K", "M", "B", "T", "Qa", "Qi"}
    local idx = 1
    while number >= 1000 and idx < #abbr do
        number = number / 1000
        idx += 1
    end
    return string.format("%.2f", number) .. abbr[idx]
end


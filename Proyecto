            end
            hrp.CFrame = hum:GetAttribute("LockCFrame") or hrp.CFrame
            hrp.Velocity = Vector3.zero; hrp.RotVelocity = Vector3.zero
        end)
    else
        if lockConnection then lockConnection:Disconnect(); lockConnection = nil end
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16; hum.JumpPower = 50; hum.AutoRotate = true
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            if hum:FindFirstChild("LockState") then hum.LockState:Destroy() end
        end
    end
end)


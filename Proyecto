local function formatNumberCalc(number)
    local isNegative = number < 0
    number = math.abs(number)
    if number >= 1e15 then
        return (isNegative and "-" or "") .. string.format("%.2fQa", number / 1e15)
    elseif number >= 1e12 then
        return (isNegative and "-" or "") .. string.format("%.2fT", number / 1e12)
    elseif number >= 1e9 then
        return (isNegative and "-" or "") .. string.format("%.2fB", number / 1e9)
    elseif number >= 1e6 then
        return (isNegative and "-" or "") .. string.format("%.2fM", number / 1e6)
    elseif number >= 1e3 then
        return (isNegative and "-" or "") .. string.format("%.2fK", number / 1e3)
    else
        return (isNegative and "-" or "") .. string.format("%.2f", number)
    end
end

local stopwatchLabel = features:AddLabel("Fast Rep Time: 0d 0h 0m 0s")
stopwatchLabel.TextSize = 20

local projectedStrengthLabel = features:AddLabel("Strength Rate: 0 /Hour | 0 /Day | 0 /Week | 0 /Month")
projectedStrengthLabel.TextSize = 20

local projectedDurabilityLabel = features:AddLabel("Durability Rate: 0 /Hour | 0 /Day | 0 /Week | 0 /Month")
projectedDurabilityLabel.TextSize = 20

features:AddLabel("").TextSize = 10

local statsLabel = features:AddLabel("Stats:")
statsLabel.TextSize = 24

local strengthLabel = features:AddLabel("Strength: 0 | Gained: 0")
strengthLabel.TextSize = 20

local durabilityLabel = features:AddLabel("Durability: 0 | Gained: 0")
durabilityLabel.TextSize = 20

local startTimeCalc = tick()
local initialStrengthCalc = strengthStatLocal.Value
local initialDurabilityCalc = durabilityStatLocal.Value
local trackingStartedCalc = false

local strengthHistoryCalc = {}
local durabilityHistoryCalc = {}
local calculationIntervalCalc = 10

task.spawn(function()
    local lastCalcTime = tick()
    while true do
        local currentTime = tick()
        local currentStrength = strengthStatLocal.Value
        local currentDurability = durabilityStatLocal.Value

        if not trackingStartedCalc and (currentStrength - initialStrengthCalc) >= 100e9 then
            trackingStartedCalc = true
            startTimeCalc = tick()
            strengthHistoryCalc = {}
            durabilityHistoryCalc = {}
        end

        if trackingStartedCalc then
            local elapsedTime = currentTime - startTimeCalc
            local days = math.floor(elapsedTime / (24 * 3600))
            local hours = math.floor((elapsedTime % (24 * 3600)) / 3600)
            local minutes = math.floor((elapsedTime % 3600) / 60)
            local seconds = math.floor(elapsedTime % 60)

            stopwatchLabel.Text = string.format("Fast Rep Time: %dd %dh %dm %ds", days, hours, minutes, seconds)

            local sessionStrengthDelta = currentStrength - initialStrengthCalc
            local sessionDurabilityDelta = currentDurability - initialDurabilityCalc

            strengthLabel.Text = "Strength: " .. formatNumberCalc(currentStrength) .. " | Gained: " .. formatNumberCalc(sessionStrengthDelta)
            durabilityLabel.Text = "Durability: " .. formatNumberCalc(currentDurability) .. " | Gained: " .. formatNumberCalc(sessionDurabilityDelta)

            table.insert(strengthHistoryCalc, {time = currentTime, value = currentStrength})
            table.insert(durabilityHistoryCalc, {time = currentTime, value = currentDurability})

            while #strengthHistoryCalc > 0 and currentTime - strengthHistoryCalc[1].time > calculationIntervalCalc do
                table.remove(strengthHistoryCalc, 1)
            end
            while #durabilityHistoryCalc > 0 and currentTime - durabilityHistoryCalc[1].time > calculationIntervalCalc do
                table.remove(durabilityHistoryCalc, 1)
            end

            if currentTime - lastCalcTime >= calculationIntervalCalc then
                lastCalcTime = currentTime

                if #strengthHistoryCalc >= 2 then
                    local strengthDelta = strengthHistoryCalc[#strengthHistoryCalc].value - strengthHistoryCalc[1].value
                    local strengthPerSecond = strengthDelta / calculationIntervalCalc
                    local strengthPerHour = math.floor(strengthPerSecond * 3600)
                    local strengthPerDay = math.floor(strengthPerSecond * 86400)
                    local strengthPerWeek = math.floor(strengthPerSecond * 604800)
                    local strengthPerMonth = math.floor(strengthPerSecond * 2592000)

                    projectedStrengthLabel.Text = "Strength Rate: " .. formatNumberCalc(strengthPerHour) .. "/Hour | " .. formatNumberCalc(strengthPerDay) .. "/Day | " .. formatNumberCalc(strengthPerWeek) .. "/Week | " .. formatNumberCalc(strengthPerMonth) .. "/Month"
                end

                if #durabilityHistoryCalc >= 2 then
                    local durabilityDelta = durabilityHistoryCalc[#durabilityHistoryCalc].value - durabilityHistoryCalc[1].value
                    local durabilityPerSecond = durabilityDelta / calculationIntervalCalc
                    local durabilityPerHour = math.floor(durabilityPerSecond * 3600)
                    local durabilityPerDay = math.floor(durabilityPerSecond * 86400)
                    local durabilityPerWeek = math.floor(durabilityPerSecond * 604800)
                    local durabilityPerMonth = math.floor(durabilityPerSecond * 2592000)

                    projectedDurabilityLabel.Text = "Durability Rate: " .. formatNumberCalc(durabilityPerHour) .. "/Hour | " .. formatNumberCalc(durabilityPerDay) .. "/Day | " .. formatNumberCalc(durabilityPerWeek) .. "/Week | " .. formatNumberCalc(durabilityPerMonth) .. "/Month"
                end
            end
        end

        task.wait(0.05)
    end
end)


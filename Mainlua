local bc = 0
local bd = {}

function bd:AddWindow(bi, bj)
    bc = bc + 1
    local bk = false
    bi = tostring(bi or "New Window")
    bj = typeof(bj) == "table" and bj or a
    bj.tween_time = bj.tween_time or 0.1
    bj.title_bar = bj.title_bar or {Color3.fromRGB(255, 255, 0)}
    if typeof(bj.title_bar) == "Color3" then bj.title_bar = {bj.title_bar} end
    bj.background = bj.background or {Color3.new(0.08, 0.09, 0.1)}
    if typeof(bj.background) == "Color3" then bj.background = {bj.background} end
    if not bj.main_color then bj.main_color = bj.title_bar[1] end

    local win = c:FindFirstChild("Window"):Clone()
    win.Parent = ak
    win:FindFirstChild("Title").Text = bi
    win.Size = UDim2.new(0, bj.min_size.X, 0, bj.min_size.Y)
    win.ZIndex = win.ZIndex + bc * 10
    
    local bx = {}
    win.Draggable = true
    return bx, win
end


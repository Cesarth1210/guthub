local function aO(aP, aQ, aR)
    aP, aQ, aR = aP / 255, aQ / 255, aR / 255
    local aS, aT = math.max(aP, aQ, aR), math.min(aP, aQ, aR)
    local aU, aV, aW = 0, 0, aS
    local aX = aS - aT
    aV = aS == 0 and 0 or aX / aS
    if aS == aT then
        aU = 0
    else
        if aS == aP then
            aU = (aQ - aR) / aX + (aQ < aR and 6 or 0)
        elseif aS == aQ then
            aU = (aR - aP) / aX + 2
        elseif aS == aR then
            aU = (aP - aQ) / aX + 4
        end
        aU = aU / 6
    end
    return aU, aV, aW
end


local library = {} 

function library:AddWindow(title, options) 
	title = tostring(title or "New Window") 
	options = (typeof(options) == "table") and options or ui_options 
	options.tween_time = 0.1 

	local Window = Prefabs:FindFirstChild("Window"):Clone() 
	Window.Parent = Windows 
	Window:FindFirstChild("Title").Text = title 
	Window.Size = UDim2.new(0, options.min_size.X, 0, options.min_size.Y) 

	local Bar = Window:FindFirstChild("Bar") 
	Bar.BackgroundColor3 = options.main_color 
	Bar:FindFirstChild("Base").BackgroundColor3 = options.main_color 
	Bar:FindFirstChild("Base").ImageColor3 = options.main_color 
	Bar:FindFirstChild("Top").ImageColor3 = options.main_color 

	Window.Draggable = true 

	local window_data = {} 

	function window_data:AddTab(tab_name) 
		local tab_data = {} 
		tab_name = tostring(tab_name or "New Tab") 
		
		local tabs = Window:FindFirstChild("Tabs") 
		local tab_selection = Window:FindFirstChild("TabSelection") 
		local tab_buttons = tab_selection:FindFirstChild("TabButtons") 

		tab_selection.Visible = true 

		local new_button = Prefabs:FindFirstChild("TabButton"):Clone() 
		new_button.Parent = tab_buttons 
		new_button.Text = tab_name 
		new_button.Size = UDim2.new(0, new_button.TextBounds.X + 20, 0, 20) 

		local new_tab = Prefabs:FindFirstChild("Tab"):Clone() 
		new_tab.Parent = tabs 

		local function show() 
			for _, v in pairs(tabs:GetChildren()) do 
				if v:IsA("Frame") then v.Visible = false end 
			end 
			new_tab.Visible = true 
		end 

		new_button.MouseButton1Click:Connect(show) 

		function tab_data:AddLabel(label_text) 
			local label = Prefabs:FindFirstChild("Label"):Clone() 
			label.Parent = new_tab 
			label.Text = tostring(label_text or "Label") 
			return label 
		end 

		function tab_data:AddButton(button_text, callback) 
			callback = typeof(callback) == "function" and callback or function() end 
			local button = Prefabs:FindFirstChild("Button"):Clone() 
			button.Parent = new_tab 
			button.Text = tostring(button_text or "Button") 
			button.Size = UDim2.new(0, button.TextBounds.X + 20, 0, 20) 
			if button:GetChildren()[1] then 
				button:GetChildren()[1].ImageColor3 = options.main_color 
			end 

			button.MouseButton1Click:Connect(function() 
				pcall(callback) 
			end) 
			return button 
		end 

		function tab_data:AddSwitch(switch_text, callback) 
			local switch_data = {} 
			callback = typeof(callback) == "function" and callback or function() end 

			local switch = Prefabs:FindFirstChild("Switch"):Clone() 
			switch.Parent = new_tab 
			switch:FindFirstChild("Title").Text = tostring(switch_text or "Switch") 
			if switch:GetChildren()[1] then 
				switch:GetChildren()[1].ImageColor3 = options.main_color 
			end 

			local toggled = false 
			switch.MouseButton1Click:Connect(function() 
				toggled = not toggled 
				switch.Text = toggled and "X" or "" 
				pcall(callback, toggled) 
			end) 

			function switch_data:Set(bool) 
				toggled = (typeof(bool) == "boolean") and bool or false 
				switch.Text = toggled and "X" or "" 
				pcall(callback, toggled) 
			end 

			return switch_data, switch 		end 

		return tab_data, new_tab 	end 

	return window_data, Window end 

return library

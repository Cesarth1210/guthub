                return btn
            end

            function FolderTabData:AddSwitch(text, cb)
                local f = TabData:AddSwitch(text, cb)
                -- Cambiar parent al content holder del folder
                -- (Se reubica automáticamente al último hijo creado en TabContentFrame)
                local lastChild = TabContentFrame:GetChildren()[#TabContentFrame:GetChildren()]
                if lastChild then lastChild.Parent = ContentHolder end
                return f

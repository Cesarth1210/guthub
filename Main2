            function FolderTabData:AddTextBox(text, cb)
                local f = TabData:AddTextBox(text, cb)
                local lastChild = TabContentFrame:GetChildren()[#TabContentFrame:GetChildren()]
                if lastChild then lastChild.Parent = ContentHolder end
                return f
            end

            function FolderTabData:AddDropdown(text, cb)
                local f = TabData:AddDropdown(text, cb)
                local lastChild = TabContentFrame:GetChildren()[#TabContentFrame:GetChildren()]
                if lastChild then lastChild.Parent = ContentHolder end
                return f
            end


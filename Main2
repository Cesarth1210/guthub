                local f = TabData:AddLabel(text)
                local lastChild = TabContentFrame:GetChildren()[#TabContentFrame:GetChildren()]
                if lastChild then lastChild.Parent = ContentHolder end
                return f
            end

            return FolderTabData
        end

        return TabData
    end

    return WindowObj
end


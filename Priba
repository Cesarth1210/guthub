    TabContainer.Parent = Sidebar

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout.Parent = TabContainer

    TabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabContainer.CanvasSize = UDim2.new(0, 0, 0, TabListLayout.AbsoluteContentSize.Y + 10)
    end)

    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -165, 1, -20)
    ContentContainer.Position = UDim2.new(0, 160, 0, 10)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = MainFrame

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 22, 0, 22)
    CloseBtn.Position = UDim2.new(1, -30, 0, 10)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseBtn.TextSize = 12
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.Parent = MainFrame
    CreateCorner(CloseBtn, 11)
    CreateStroke(CloseBtn, Color3.fromRGB(255, 255, 255), 1, 0.5)
    
    CloseBtn.MouseButton1Click:Connect(ToggleUI)

    local Tabs = {}
    local CurrentTab = nil

    function Tabs:CreateTab(tabName)
        local TabButton = Instance.new("TextButton")
        TabButton.Size = UDim2.new(1, -5, 0, 32)
        TabButton.BackgroundColor3 = Theme.ElementBg
        TabButton.Text = "   " .. tabName
        TabButton.TextColor3 = Theme.SubText
        TabButton.TextSize = 13
        TabButton.Font = Enum.Font.GothamMedium
        TabButton.TextXAlignment = Enum.TextXAlignment.Left
        TabButton.Parent = TabContainer
        CreateCorner(TabButton, 6)
        CreateStroke(TabButton, Theme.Border, 1, 0.5)
        
        local TabContentFrame = Instance.new("ScrollingFrame")
        TabContentFrame.Size = UDim2.new(1, 0, 1, 0)
        TabContentFrame.BackgroundTransparency = 1
        TabContentFrame.Visible = false
        TabContentFrame.ScrollBarThickness = 3
        TabContentFrame.Parent = ContentContainer
        
        local TabContentLayout = Instance.new("UIListLayout")
        TabContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        TabContentLayout.Padding = UDim.new(0, 8)
        TabContentLayout.Parent = TabContentFrame

        TabContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContentFrame.CanvasSize = UDim2.new(0, 0, 0, TabContentLayout.AbsoluteContentSize.Y + 10)
        end)

        local TabData = {}

        local function SelectTab()
            if CurrentTab then
                TweenService:Create(CurrentTab.Button, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg, TextColor3 = Theme.SubText}):Play()
                CurrentTab.Content.Visible = false
            end
            CurrentTab = {Button = TabButton, Content = TabContentFrame}
            TweenService:Create(TabButton, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Text}):Play()
            TabContentFrame.Visible = true
        end

        TabButton.MouseButton1Click:Connect(SelectTab)
        if not CurrentTab then SelectTab() end

        function TabData:AddButton(text, callback)
            local Btn = Instance.new("TextButton")
            Btn.Size = UDim2.new(1, -5, 0, 36)
            Btn.BackgroundColor3 = Theme.ElementBg
            Btn.Text = text
            Btn.TextColor3 = Theme.Text
            Btn.TextSize = 13
            Btn.Font = Enum.Font.GothamMedium
            Btn.Parent = TabContentFrame
            CreateCorner(Btn, 6)
            CreateStroke(Btn, Theme.Border, 1, 0.5)
            
            Btn.MouseButton1Click:Connect(function()
                if callback then pcall(callback) end
            end)
            return Btn
        end

        function TabData:AddToggle(text, default, callback)
            local ToggleFrame = Instance.new("Frame")
            ToggleFrame.Size = UDim2.new(1, -5, 0, 36)
            ToggleFrame.BackgroundColor3 = Theme.ElementBg
            ToggleFrame.Parent = TabContentFrame
            CreateCorner(ToggleFrame, 6)
            CreateStroke(ToggleFrame, Theme.Border, 1, 0.5)

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(1, -60, 1, 0)
            Label.Position = UDim2.new(0, 10, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Theme.Text
            Label.TextSize = 13
            Label.Font = Enum.Font.GothamMedium
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = ToggleFrame

            local SwitchBg = Instance.new("Frame")
            SwitchBg.Size = UDim2.new(0, 40, 0, 20)
            SwitchBg.Position = UDim2.new(1, -50, 0.5, -10)
            SwitchBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            SwitchBg.Parent = ToggleFrame
            CreateCorner(SwitchBg, 10)

            local SwitchCircle = Instance.new("Frame")
            SwitchCircle.Size = UDim2.new(0, 16, 0, 16)
            SwitchCircle.Position = UDim2.new(0, 2, 0.5, -8)
            SwitchCircle.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
            SwitchCircle.Parent = SwitchBg
            CreateCorner(SwitchCircle, 10)

            local Toggled = default or false
            
            local function UpdateState()
                if Toggled then
                    SwitchBg.BackgroundColor3 = Theme.Accent
                    SwitchCircle.Position = UDim2.new(1, -18, 0.5, -8)
                    SwitchCircle.BackgroundColor3 = Color3.fromRGB(255,255,255)
                else
                    SwitchBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
                    SwitchCircle.Position = UDim2.new(0, 2, 0.5, -8)
                    SwitchCircle.BackgroundColor3 = Color3.fromRGB(200,200,200)
                end
            end
            
            UpdateState()

            local BtnClick = Instance.new("TextButton")
            BtnClick.Size = UDim2.new(1, 0, 1, 0)
            BtnClick.BackgroundTransparency = 1
            BtnClick.Text = ""
            BtnClick.Parent = ToggleFrame
            
            BtnClick.MouseButton1Click:Connect(function()
                Toggled = not Toggled
                UpdateState()
                if callback then pcall(callback, Toggled) end
            end)
            
            return {
                Set = function(val)
                    Toggled = val
                    UpdateState()
                    if callback then pcall(callback, Toggled) end
                end
            }
        end

        function TabData:AddSlider(text, min, max, default, callback)
            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, -5, 0, 50)
            SliderFrame.BackgroundColor3 = Theme.ElementBg
            SliderFrame.Parent = TabContentFrame
            CreateCorner(SliderFrame, 6)
            CreateStroke(SliderFrame, Theme.Border, 1, 0.5)

            local Title = Instance.new("TextLabel")
            Title.Size = UDim2.new(1, -20, 0, 20)
            Title.Position = UDim2.new(0, 10, 0, 5)
            Title.BackgroundTransparency = 1
            Title.Text = text
            Title.TextColor3 = Theme.Text
            Title.TextSize = 13
            Title.Font = Enum.Font.GothamMedium
            Title.TextXAlignment = Enum.TextXAlignment.Left
            Title.Parent = SliderFrame

            local ValueLabel = Instance.new("TextLabel")
            ValueLabel.Size = UDim2.new(0, 50, 0, 20)
            ValueLabel.Position = UDim2.new(1, -60, 0, 5)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = tostring(default)
            ValueLabel.TextColor3 = Theme.Accent
            ValueLabel.TextSize = 13
            ValueLabel.Font = Enum.Font.GothamBold
            ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValueLabel.Parent = SliderFrame

            local BarBg = Instance.new("Frame")
            BarBg.Size = UDim2.new(1, -20, 0, 6)
            BarBg.Position = UDim2.new(0, 10, 0, 32)
            BarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            BarBg.Parent = SliderFrame
            CreateCorner(BarBg, 3)

            local BarFill = Instance.new("Frame")
            BarFill.Size = UDim2.new(0, 0, 1, 0)
            BarFill.BackgroundColor3 = Theme.Accent
            BarFill.Parent = BarBg
            CreateCorner(BarFill, 3)

            local dragging = false

            local function UpdateSlider(input)
                local barPos = BarBg.AbsolutePosition.X
                local barSize = BarBg.AbsoluteSize.X
                local percentage = math.clamp((input.Position.X - barPos) / barSize, 0, 1)
                
                local val = math.floor(min + (max - min) * percentage)
                ValueLabel.Text = tostring(val)
                BarFill.Size = UDim2.new(percentage, 0, 1, 0)
                
                if callback then pcall(callback, val) end
            end

            BarBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            
            local initPercent = (default - min) / (max - min)
            BarFill.Size = UDim2.new(initPercent, 0, 1, 0)
            
            return {
                Set = function(val)
                    local clampedVal = math.clamp(val, min, max)
                    local percent = (clampedVal - min) / (max - min)
                    ValueLabel.Text = tostring(clampedVal)
                    BarFill.Size = UDim2.new(percent, 0, 1, 0)
                    if callback then pcall(callback, clampedVal) end
                end
            }
        end

        return TabData
    end

    return Tabs
end


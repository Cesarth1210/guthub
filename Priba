    Sidebar = Color3.fromRGB(20, 20, 26),
    Accent = Color3.fromRGB(160, 50, 255),
    AccentHover = Color3.fromRGB(180, 80, 255),
    Text = Color3.fromRGB(240, 240, 240),
    SubText = Color3.fromRGB(160, 160, 170),
    ElementBg = Color3.fromRGB(28, 28, 35),

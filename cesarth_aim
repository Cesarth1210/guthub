local Unloaded = false
local Connections = {}

local function Track(conn)
    if typeof(conn) == "RBXScriptConnection" then
        table.insert(Connections, conn)
    elseif type(conn) == "thread" then
        table.insert(Connections, { Disconnect = function() task.cancel(conn) end })
    end
    return conn
end

local function SafeParent(gui, parent)
    local ok = pcall(function() gui.Parent = parent end)
    return ok
end

local function Adopt(gui)
    local ok, h = pcall(function() return gethui() end)
    if ok and h and typeof(h) == "Instance" then
        if SafeParent(gui, h) then return end
    end
    local ok2, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and coreGui then
        if SafeParent(gui, coreGui) then return end
    end
    local ok3, playerGui = pcall(function() return LocalPlayer:WaitForChild("PlayerGui", 5) end)
    if ok3 and playerGui then
        SafeParent(gui, playerGui)
    end
end

local function CleanupOldInstances()
    local names = { "EmberRoot", "EmberToasts", "EmberESP", "EmberFOV" }
    local ok, h = pcall(function() return gethui() end)
    if ok and h and typeof(h) == "Instance" then
        for _, name in ipairs(names) do
            pcall(function()
                local child = h:FindFirstChild(name)
                if child then child:Destroy() end
            end)
        end
    end
    pcall(function()
        local coreGui = game:GetService("CoreGui")
        for _, name in ipairs(names) do
            local child = coreGui:FindFirstChild(name)
            if child then child:Destroy() end
        end
    end)
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, name in ipairs(names) do
                local child = playerGui:FindFirstChild(name)
                if child then child:Destroy() end
            end
        end
    end)
end

CleanupOldInstances()

